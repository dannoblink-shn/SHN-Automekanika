        "paymentStatus": {
          "type": "string",
          "enum": ["Pendiente", "Abonado", "Pagado"]
        },
        "paymentNotes": {
          "type": "string",
          "maxLength": 200
        },
        "mechanicCommissionRate": {
          "type": "number"
        },
        "mechanicPaid": {
          "type": "number"
        },
        "mechanicPaymentStatus": {
          "type": "string",
          "enum": ["Pendiente", "Abonado", "Pagado"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
