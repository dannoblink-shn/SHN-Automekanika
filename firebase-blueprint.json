  },
  "firestore": {
    "/shops/{shopId}": {
      "schema": { "$ref": "#/entities/Shop" },
      "description": "Root workspace document for an automotive repair shop."
    },
    "/shops/{shopId}/customers/{customerId}": {
      "schema": { "$ref": "#/entities/Customer" },
      "description": "Shop customers directory."
    },
    "/shops/{shopId}/vehicles/{vehicleId}": {
      "schema": { "$ref": "#/entities/Vehicle" },
      "description": "Vehicles belonging to shop customers."
    },
    "/shops/{shopId}/mechanics/{mechanicId}": {
      "schema": { "$ref": "#/entities/Mechanic" },
      "description": "Workshop mechanics and bay assignments."
    },
    "/shops/{shopId}/parts/{partId}": {
      "schema": { "$ref": "#/entities/Part" },
      "description": "Spare parts inventory."
    },
    "/shops/{shopId}/workOrders/{orderId}": {
      "schema": { "$ref": "#/entities/WorkOrder" },
      "description": "Active and historical repair work orders."
    },
    "/shops/{shopId}/workOrders/{orderId}/items/{itemId}": {
      "schema": { "$ref": "#/entities/WorkOrderItem" },
      "description": "Line items (labor and spare parts) for a work order."
    },
    "/shops/{shopId}/appointments/{appointmentId}": {
      "schema": { "$ref": "#/entities/Appointment" },
      "description": "Scheduled service appointments."
    },
    "/shops/{shopId}/quotes/{quoteId}": {
      "schema": { "$ref": "#/entities/Quote" },
      "description": "Itemized service and parts budgets."
    },
    "/shops/{shopId}/quotes/{quoteId}/items/{itemId}": {
      "schema": { "$ref": "#/entities/QuoteItem" },
      "description": "Individual parts and labor line items inside a quote."
    }
  }
}
