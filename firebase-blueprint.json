{
  "entities": {
    "Shop": {
      "title": "Shop",
      "description": "Automotive repair shop workspace configuration and owner profile.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "phone": {
          "type": "string",
          "maxLength": 30
        },
        "address": {
          "type": "string",
          "maxLength": 200
        },
        "taxRate": {
          "type": "number"
        },
        "currency": {
          "type": "string",
          "enum": ["USD", "VES", "MXN", "EUR", "COP", "ARS", "CLP", "PEN"]
        },
        "baysCount": {
          "type": "number"
        },
        "bcvRate": {
          "type": "number"
        },
        "bcvUpdatedAt": {
          "type": "string",
          "maxLength": 50
        },
        "bcvSource": {
          "type": "string",
          "maxLength": 60
        },
        "mechanicCommissionRate": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "name", "phone", "address", "taxRate", "currency", "baysCount", "createdAt", "updatedAt"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Workshop client record with contact details.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "phone": {
          "type": "string",
          "minLength": 5,
          "maxLength": 30
        },
        "email": {
          "type": "string",
          "maxLength": 120
        },
        "taxId": {
          "type": "string",
          "maxLength": 40
        },
        "notes": {
          "type": "string",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "name", "phone", "email", "taxId", "notes", "createdAt", "updatedAt"]
    },
    "Vehicle": {
      "title": "Vehicle",
